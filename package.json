{
  "name": "claimcheck-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClaimCheck AI — an evidence-based research paper auditing workbench",
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "cross-env NODE_ENV=production tsx server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:evaluation",
    "test:unit": "node --import tsx --test tests/extraction.test.ts tests/audit.test.ts tests/reports.test.ts tests/api.test.ts tests/engine_new.test.ts tests/extraction_regression.test.ts tests/two_column_layout.test.ts tests/consistency_checks.test.ts tests/table_evidence.test.ts tests/voice.test.ts tests/benchmark.test.ts tests/privacy.test.ts",
    "test:evaluation": "tsx evaluation/run.ts",
    "test:write": "tsx evaluation/run.ts --write",
    "test:publish": "tsx evaluation/run.ts --write --publish",
    "sample": "tsx scripts/generate-samples.ts",
    "benchmark": "tsx benchmark/cli.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.9",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "pdfkit": "^0.17.2",
    "@types/pdfkit": "^0.14.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=22.5"
  }
}
